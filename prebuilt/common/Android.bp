prebuilt_etc_xml {
    name: "sensitive_pn.xml",
    product_specific: true,
    src: "etc/sensitive_pn.xml",
    schema: ":spn-schema",
}

prebuilt_etc_xml {
    name: "lineage-component-overrides.xml",
    product_specific: true,
    src: "etc/lineage-component-overrides.xml",
    sub_dir: "sysconfig",
}

// prebuilt_addon_d is a custom module that installs to <partition>/addon.d.
prebuilt_addon_d {
    name: "50-lineage.sh",
    src: "bin/50-lineage.sh",
    filename_from_src: true,
}
