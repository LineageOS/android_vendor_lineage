//lineage_charger_density = select(soong_config_variable("lineage_charger", "density"), {
//    any @ flag_val: flag_val,
//    default: "mdpi",
//})

lineage_charger_density = "mdpi"

prebuilt_etc {
    name: "lineage_charger",

    srcs: [
        "animation.txt",
        lineage_charger_density + "/battery_fail.png",
        lineage_charger_density + "/battery_scale.png",
        lineage_charger_density + "/percent_font.png",
    ],
    dsts: [
        "res/values/charger/animation.txt",
        "res/images/charger/battery_fail.png",
        "res/images/charger/battery_scale.png",
        "res/images/charger/percent_font.png",
    ],

    product_specific: true,
}

prebuilt_etc {
    name: "lineage_charger_vendor",

    srcs: [
        "animation.txt",
        lineage_charger_density + "/battery_fail.png",
        lineage_charger_density + "/battery_scale.png",
        lineage_charger_density + "/percent_font.png",
    ],
    dsts: [
        "res/values/charger/animation.txt",
        "res/images/charger/battery_fail.png",
        "res/images/charger/battery_scale.png",
        "res/images/charger/percent_font.png",
    ],

    vendor: true,
}
